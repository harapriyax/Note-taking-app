{
  "name": "noteflow-backend",
  "version": "2.0.0",
  "description": "NoteFlow Serverless Backend - Lambda + DynamoDB + Cognito + API Gateway",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "deploy": "serverless deploy --stage live",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove --stage live",
    "logs:notes": "serverless logs -f notesList --stage live",
    "logs:postconfirm": "serverless logs -f postConfirmation --stage live"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "serverless": "^3.40.0"
  }
}
